    "custom_liquid_VKeDRY": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{%- assign gift_collection = collections['creator-gifts'] -%}\n{%- assign agreement_url = 'https://docs.google.com/forms/d/e/1FAIpQLSfRW-3NKnnzOcFAwP35nQCw08C0Fs3_qOi1o6Y4r7ej54ImeA/viewform' -%}\n\n<style>\n  .cg { --cg-accent:#f5631e; --cg-accent-2:#ff8a3d; max-width: 1000px; margin: 0 auto; padding: 1.25rem; }\n  .cg__head { text-align: center; margin-bottom: 1.25rem; }\n  .cg__head h1 { font-size: 1.9rem; font-weight: 800; margin: 0 0 .4rem; letter-spacing: -.01em; }\n  .cg__head p { margin: 0; opacity: .8; }\n  .cg__hint { font-size: .85rem; opacity: .65; }\n  .cg__step { font-weight: 800; font-size: 1.05rem; margin: 1.6rem 0 .6rem; display: flex; align-items: center; gap: .5rem; }\n  .cg__step::before { content: attr(data-n); display: inline-flex; align-items: center; justify-content: center; width: 1.5rem; height: 1.5rem; border-radius: 50%; background: var(--cg-accent); color: #fff; font-size: .8rem; }\n\n  .cg__grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: .6rem; }\n  @media (min-width: 600px) { .cg__grid { grid-template-columns: repeat(3, 1fr); gap: .9rem; } }\n  @media (min-width: 900px) { .cg__grid { grid-template-columns: repeat(4, 1fr); } }\n\n  .cg-tile { position: relative; border-radius: 16px; overflow: hidden; background: #fff; border: 2px solid transparent; box-shadow: 0 1px 5px rgba(0,0,0,.09); cursor: pointer; transition: transform .15s ease, box-shadow .15s ease, border-color .15s ease; -webkit-tap-highlight-color: transparent; }\n  .cg-tile:active { transform: scale(.98); }\n  .cg-tile.is-on { border-color: var(--cg-accent); box-shadow: 0 6px 20px rgba(245,99,30,.32); }\n  .cg-tile__media { position: relative; aspect-ratio: 1 / 1; background: #f3f3f3; }\n  .cg-tile__media img { width: 100%; height: 100%; object-fit: cover; display: block; }\n  .cg-tile.is-on .cg-tile__media::after { content: \"\"; position: absolute; inset: 0; background: rgba(245,99,30,.12); }\n  .cg-tile__badge { position: absolute; top: .5rem; left: .5rem; background: var(--cg-accent); color: #fff; font-size: .65rem; font-weight: 800; letter-spacing: .04em; padding: .2rem .5rem; border-radius: 999px; }\n  .cg-tile__check { position: absolute; top: .5rem; right: .5rem; width: 1.6rem; height: 1.6rem; border-radius: 50%; background: var(--cg-accent); color: #fff; display: none; align-items: center; justify-content: center; font-size: .95rem; font-weight: 800; box-shadow: 0 2px 6px rgba(0,0,0,.25); }\n  .cg-tile.is-on .cg-tile__check { display: flex; }\n  .cg-tile__body { padding: .5rem .6rem .65rem; }\n  .cg-tile__title { font-size: .78rem; font-weight: 600; line-height: 1.25; display: block; }\n  .cg-tile select { margin-top: .4rem; width: 100%; font-size: .78rem; padding: .3rem; border: 1px solid #ccc; border-radius: 6px; }\n  .cg__sel { text-align: center; font-size: .9rem; margin-top: .8rem; }\n  .cg__sel strong { color: var(--cg-accent); }\n\n  .cg-form { margin-top: .4rem; display: grid; gap: .6rem; max-width: 520px; }\n  .cg-field { display: grid; gap: .25rem; }\n  .cg-field input { padding: .7rem; border: 1px solid #ccc; border-radius: 10px; width: 100%; font-size: 16px; }\n  .cg-field input.is-bad { border-color: #c00; }\n  .cg-field input.is-good { border-color: #1a7f37; }\n  .cg-field__msg { font-size: .75rem; color: #c00; display: none; }\n  .cg-field.is-bad .cg-field__msg { display: block; }\n\n  .cg-agree { margin-top: 1.1rem; display: grid; gap: .6rem; max-width: 520px; }\n  .cg-agree__open { display: inline-flex; align-items: center; gap: .3rem; padding: .6rem 1rem; border: 2px solid var(--cg-accent); border-radius: 10px; text-decoration: none; color: var(--cg-accent); font-weight: 700; width: max-content; }\n  .cg-agree__check { display: flex; gap: .5rem; align-items: flex-start; font-size: .9rem; }\n  .cg-agree__check input { margin-top: .2rem; width: 1.1rem; height: 1.1rem; }\n\n  .cg__footer { margin-top: 1.6rem; display: grid; gap: .55rem; max-width: 520px; }\n  .cg__todo { font-size: .8rem; opacity: .7; }\n  .cg__cta { width: 100%; padding: 1.05rem; border: none; border-radius: 14px; background: linear-gradient(135deg, var(--cg-accent), var(--cg-accent-2)); color: #fff; font-size: 1.15rem; font-weight: 800; cursor: pointer; box-shadow: 0 8px 22px rgba(245,99,30,.38); transition: transform .12s ease, opacity .12s ease; }\n  .cg__cta:active { transform: translateY(1px); }\n  .cg__cta:disabled { background: #cfcfcf; box-shadow: none; cursor: not-allowed; }\n  .cg-error { color: #c00; font-size: .85rem; }\n</style>\n\n<div class=\"cg\" id=\"cg-app\">\n  <div class=\"cg__head\">\n    <h1>Get your free product 🎁</h1>\n    <p>Pick <strong>one</strong> item on us — we'll ship it your way.</p>\n  </div>\n\n  {%- if gift_collection == blank or gift_collection.products_count == 0 -%}\n    <p>No gift products are available right now. (Add products to the “Creator Gifts” collection.)</p>\n  {%- else -%}\n\n    <p class=\"cg__step\" data-n=\"1\">Choose your product</p>\n    <div class=\"cg__grid\">\n      {%- for product in gift_collection.products -%}\n        <div class=\"cg-tile\" data-tile data-title=\"{{ product.title | remove: '[Creator Gift]' | strip | escape }}\">\n          <div class=\"cg-tile__media\">\n            {%- if product.featured_image -%}\n              <img src=\"{{ product.featured_image | image_url: width: 600 }}\" alt=\"{{ product.title | escape }}\" loading=\"lazy\" width=\"600\">\n            {%- endif -%}\n            <span class=\"cg-tile__badge\">FREE</span>\n            <span class=\"cg-tile__check\" aria-hidden=\"true\">✓</span>\n          </div>\n          <div class=\"cg-tile__body\">\n            <span class=\"cg-tile__title\">{{ product.title | remove: '[Creator Gift]' | strip }}</span>\n            {%- if product.variants.size > 1 -%}\n              <select data-variant>\n                {%- for v in product.variants -%}\n                  <option value=\"{{ v.id }}\" {% unless v.available %}disabled{% endunless %}>\n                    {{ v.title }}{% unless v.available %} — Sold out{% endunless %}\n                  </option>\n                {%- endfor -%}\n              </select>\n            {%- else -%}\n              <input type=\"hidden\" data-variant value=\"{{ product.variants.first.id }}\">\n            {%- endif -%}\n          </div>\n        </div>\n      {%- endfor -%}\n    </div>\n    <p class=\"cg__sel\">Selected: <strong data-sel>none yet</strong></p>\n\n    <p class=\"cg__step\" data-n=\"2\">Where can we see your content?</p>\n    <p class=\"cg__hint\">Add at least one — Instagram, TikTok, or YouTube.</p>\n    <div class=\"cg-form\">\n      <div class=\"cg-field\">\n        <input type=\"text\" data-social=\"Instagram\" placeholder=\"Instagram handle (e.g. @yourname)\">\n        <span class=\"cg-field__msg\">That doesn't look like a valid Instagram handle.</span>\n      </div>\n      <div class=\"cg-field\">\n        <input type=\"text\" data-social=\"TikTok\" placeholder=\"TikTok handle (e.g. @yourname)\">\n        <span class=\"cg-field__msg\">That doesn't look like a valid TikTok handle.</span>\n      </div>\n      <div class=\"cg-field\">\n        <input type=\"text\" data-social=\"YouTube\" placeholder=\"YouTube channel (@handle or link)\">\n        <span class=\"cg-field__msg\">That doesn't look like a valid YouTube channel.</span>\n      </div>\n      <div class=\"cg-field\">\n        <input type=\"text\" data-social=\"Other\" placeholder=\"Other (optional)\">\n      </div>\n    </div>\n\n    <p class=\"cg__step\" data-n=\"3\">Sign the agreement</p>\n    <div class=\"cg-agree\">\n      <a class=\"cg-agree__open\" href=\"{{ agreement_url }}\" target=\"_blank\" rel=\"noopener\">Read &amp; sign the agreement ↗</a>\n      <label class=\"cg-agree__check\">\n        <input type=\"checkbox\" data-agree>\n        <span>I have read, signed, and agree to the influencer agreement — I'll receive this item free in exchange for a social media post/video.</span>\n      </label>\n    </div>\n\n    <div class=\"cg__footer\">\n      <p class=\"cg-error\" data-error hidden></p>\n      <p class=\"cg__todo\" data-todo></p>\n      <button type=\"button\" class=\"cg__cta\" data-checkout disabled>Create &amp; ship my partner box 🎁</button>\n    </div>\n  {%- endif -%}\n</div>\n\n<script>\n(function () {\n  var app = document.getElementById('cg-app');\n  if (!app) return;\n\n  var selEl = null, selVariant = null, selTitle = null;\n  var selOut = app.querySelector('[data-sel]');\n  var checkoutBtn = app.querySelector('[data-checkout]');\n  var agreeEl = app.querySelector('[data-agree]');\n  var errorEl = app.querySelector('[data-error]');\n  var todoEl = app.querySelector('[data-todo]');\n\n  app.querySelectorAll('[data-tile]').forEach(function (tile) {\n    var variant = tile.querySelector('[data-variant]');\n    if (!variant) return;\n\n    tile.addEventListener('click', function (e) {\n      if (e.target.closest('[data-variant]')) return;\n      if (selEl === tile) {\n        tile.classList.remove('is-on');\n        selEl = null; selVariant = null; selTitle = null;\n      } else {\n        if (selEl) selEl.classList.remove('is-on');\n        selEl = tile; tile.classList.add('is-on');\n        selVariant = variant.value;\n        selTitle = tile.getAttribute('data-title');\n      }\n      refresh();\n    });\n\n    if (variant.tagName === 'SELECT') {\n      variant.addEventListener('click', function (e) { e.stopPropagation(); });\n      variant.addEventListener('change', function () { if (selEl === tile) selVariant = variant.value; });\n    }\n  });\n\n  function clean(v) { return v.trim().replace(/^@+/, '').replace(/\\/+$/, ''); }\n  function isHandle(v, max) { return new RegExp('^[a-zA-Z0-9._]{2,' + max + '}$').test(v) && /[a-zA-Z]/.test(v); }\n  var validators = {\n    Instagram: function (v) { return /instagram\\.com\\/[a-zA-Z0-9._]{2,}/i.test(v) || isHandle(clean(v), 30); },\n    TikTok:    function (v) { return /tiktok\\.com\\/@?[a-zA-Z0-9._]{2,}/i.test(v) || isHandle(clean(v), 24); },\n    YouTube:   function (v) { return /(youtube\\.com|youtu\\.be)\\/.+/i.test(v) || (isHandle(clean(v), 30) && clean(v).length >= 3); }\n  };\n\n  var socialInputs = Array.prototype.slice.call(app.querySelectorAll('[data-social]'));\n  socialInputs.forEach(function (input) {\n    input.addEventListener('input', function () {\n      var type = input.getAttribute('data-social');\n      var field = input.closest('.cg-field');\n      var val = input.value.trim();\n      var check = validators[type];\n      if (!val || !check) {\n        input.classList.remove('is-bad', 'is-good');\n        if (field) field.classList.remove('is-bad');\n      } else if (check(val)) {\n        input.classList.add('is-good'); input.classList.remove('is-bad');\n        if (field) field.classList.remove('is-bad');\n      } else {\n        input.classList.add('is-bad'); input.classList.remove('is-good');\n        if (field) field.classList.add('is-bad');\n      }\n      refresh();\n    });\n  });\n\n  function hasValidSocial() {\n    return ['Instagram', 'TikTok', 'YouTube'].some(function (type) {\n      var input = app.querySelector('[data-social=\"' + type + '\"]');\n      var val = input ? input.value.trim() : '';\n      return val && validators[type](val);\n    });\n  }\n\n  agreeEl.addEventListener('change', refresh);\n\n  function refresh() {\n    var needs = [];\n    if (!selVariant) needs.push('pick 1 product');\n    if (!hasValidSocial()) needs.push('add a valid Instagram, TikTok, or YouTube');\n    if (!agreeEl.checked) needs.push('check the agreement box');\n\n    selOut.textContent = selTitle || 'none yet';\n    checkoutBtn.disabled = needs.length > 0;\n    todoEl.textContent = needs.length ? 'To continue: ' + needs.join(', ') + '.' : '';\n  }\n  refresh();\n\n  checkoutBtn.addEventListener('click', function () {\n    errorEl.hidden = true;\n    if (checkoutBtn.disabled || !selVariant) return;\n\n    checkoutBtn.disabled = true;\n    checkoutBtn.textContent = 'Preparing…';\n\n    var attributes = { 'Creator gift': 'Yes', 'Influencer agreement': 'Accepted' };\n    socialInputs.forEach(function (input) {\n      if (input.value.trim()) attributes[input.getAttribute('data-social')] = input.value.trim();\n    });\n\n    var items = [{ id: Number(selVariant), quantity: 1 }];\n\n    fetch('/cart/clear.js', { method: 'POST', headers: { 'Content-Type': 'application/json' } })\n      .then(function () {\n        return fetch('/cart/add.js', {\n          method: 'POST',\n          headers: { 'Content-Type': 'application/json' },\n          body: JSON.stringify({ items: items })\n        });\n      })\n      .then(function (r) { if (!r.ok) throw new Error('Could not add the item to the cart.'); return r.json(); })\n      .then(function () {\n        return fetch('/cart/update.js', {\n          method: 'POST',\n          headers: { 'Content-Type': 'application/json' },\n          body: JSON.stringify({ attributes: attributes })\n        });\n      })\n      .then(function () { window.location.href = '/checkout'; })\n      .catch(function (err) {\n        showError(err.message || 'Something went wrong. Please try again.');\n        checkoutBtn.disabled = false;\n        checkoutBtn.textContent = 'Create & ship my partner box 🎁';\n      });\n  });\n\n  function showError(msg) { errorEl.textContent = msg; errorEl.hidden = false; }\n})();\n</script>",
        "color_scheme": "scheme-3",
        "padding_top": 42,
        "padding_bottom": 44
      }
    }
  },
