<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Keeps automation/local-runner.mjs running on the Mac. Install: see automation/LOCAL_RUNNER.md -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.bodyj4you.runner</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string><string>-lc</string>
    <string>cd "$HOME/bodyj4you/automation" &amp;&amp; exec node local-runner.mjs</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/tmp/bodyj4you-runner.log</string>
  <key>StandardErrorPath</key><string>/tmp/bodyj4you-runner.log</string>
</dict>
</plist>
